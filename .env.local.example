# --- Sign in with Google ------------------------------------------------------
# Without these the app runs as a single local ledger (no sign-in screen).
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials ->
# OAuth client ID -> Web application. Add this authorized redirect URI:
#     http://localhost:3000/api/auth/callback/google
# (add the deployed URL too when you host it).
#
# Two-step verification is handled by the Google account itself — turn it on at
# https://myaccount.google.com/security. The app doesn't store a second factor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Where each signed-in account's ledger is written — one JSON file per Google
# account id. Defaults to `.data/` inside the project (gitignored). Point it at
# a folder you back up if you like, e.g.
# LEDGER_DATA_DIR=C:/Users/Reki/Documents/ledger-data

# --- Live market data ---------------------------------------------------------
# Crypto (BTC, ETH, SOL, ...) is always live via Yahoo Finance — no key needed.
#
# Stocks / ETFs (AAPL, NVDA, VOO, SGOV, ...):
#   • With a Finnhub key below  -> real-time quotes via Finnhub.
#   • Without it                -> quotes via Yahoo Finance (no signup, may be delayed).
#
# Get a free key at https://finnhub.io/register, then copy this file to
# `.env.local` and paste your key. Restart `npm run dev` after changing it.
FINNHUB_API_KEY=

# Optional: how often the portfolio refreshes prices, in milliseconds (default 15000).
# NEXT_PUBLIC_PRICE_REFRESH_MS=15000
